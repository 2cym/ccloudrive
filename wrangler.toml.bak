#:schema node_modules/wrangler/config-schema.json
name = "yuanshennb"
main = ".open-next/worker.js"
compatibility_date = "2024-12-30"

# Workers 无 Node 文件系统；Next.js 运行时需要 nodejs_compat
compatibility_flags = ["nodejs_compat"]

[assets]
directory = ".open-next/assets"
binding = "ASSETS"

[vars]
NEXT_PUBLIC_APP_NAME = "云盘"
# 部署后拿到 workers.dev 地址再改，改成 https://yuanshennb.<你的子域>.workers.dev
AUTH_URL = "http://localhost:8788"

[[d1_databases]]
binding = "DB"
database_name = "yuanshennb-db"
database_id = "d20cd86c-61d1-4622-9489-8f779fe056da"
migrations_dir = "drizzle/migrations"

# R2 暂时不启用（需要绑卡开通，后续文件管理时再补）
# [[r2_buckets]]
# binding = "BUCKET"
# bucket_name = "yuanshennb-files"

[[kv_namespaces]]
binding = "KV"
id = "36c3f3c9f12547a5a12733e345117230"

[observability]
enabled = true